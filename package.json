{
  "name": "dsh-usage-peak",
  "version": "1.6.7",
  "type": "module",
  "description": "DeepSeek Harness 用量峰谷仪表盘：峰/谷时段（含节假日与调休）、按请求开始时刻计价、自定义价目表、今日花费与 tokens、项目下钻/模型统计、可配置预算预警、余额可撑天数、CSV 导出、7/14/30 天窗口、缓存命中、谷时更省，侧栏常驻胶囊 + 设置页详情。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "holidays.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "assets/*.webp",
    "test/*.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible",
        "0.2.2-rc.5": "compatible"
      }
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "usage",
    "tokens",
    "cost",
    "deepseek-api",
    "peak-pricing",
    "cordis",
    "react"
  ],
  "private": false,
  "author": "mumuhmumu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hseons/dsh-usage-peak.git"
  },
  "homepage": "https://github.com/hseons/dsh-usage-peak#readme",
  "bugs": {
    "url": "https://github.com/hseons/dsh-usage-peak/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check client.js && npm test"
  }
}
